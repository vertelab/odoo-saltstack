<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sync dirvish-branches (Återskapa data) — runs daily after the
         dirvish-status report (06:28 on the dirvish servers) and after
         dirvish-publish (06:30 on the master). Endast branches MED tree/
         (data) blir rader — tomma datumkataloger filtreras bort. -->
    <record id="cron_sync_dirvish_snapshots" model="ir.cron">
        <field name="name">Saltstack: synk dirvish-snapshots (Återskapa data)</field>
        <field name="model_id" ref="saltstack.model_salt_minion_snapshot"/>
        <field name="state">code</field>
        <field name="code">model.action_sync_dirvish_snapshots()</field>
        <field name="interval_number">24</field>
        <field name="interval_type">hours</field>
        <field name="nextcall">2026-09-12 07:00:00</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
