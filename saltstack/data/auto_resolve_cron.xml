<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── [ERSATT] Auto-resolve av driftslarm — flyttad 2026-10-22 ──── -->
    <!--
        Jobbet schemaläggs nu av `cron_tick` som `cron.task`
        `alert_auto_resolve` (data/cron_tasks.xml, kadens `min`,
        sequence 20).

        Posten ligger kvar med `active=False` och full definition — se
        kommentaren i `data/sync_cron.xml` för varför (mönstret från
        `ai_agent_core/data/cron_heartbeat.xml`).

        Jobbet är tidsokänsligt (7/14-dygnsregler + live Zabbix-fråga), så
        5 minuter i stället för 15 är en förbättring.
    -->
    <record id="cron_auto_resolve_alerts" model="ir.cron">
        <field name="name">[ERSATT] Saltstack: auto-resolve driftlarm</field>
        <field name="model_id" ref="model_saltstack_alert"/>
        <field name="state">code</field>
        <field name="code">model.action_cron_auto_resolve()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
