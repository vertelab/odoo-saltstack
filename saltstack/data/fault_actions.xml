<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- FAULT INJECTION SERVER ACTIONS — salt.minion                     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <record id="action_fault_stop_odoo" model="ir.actions.server">
        <field name="name">🛑 Stoppa Odoo (felinjektion)</field>
        <field name="model_id" ref="model_salt_minion"/>
        <field name="binding_model_id" ref="model_salt_minion"/>
        <field name="state">code</field>
        <field name="code">records.action_fault_stop_odoo()</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="action_fault_grow_log" model="ir.actions.server">
        <field name="name">💾 Simulera disk full (växande loggfil)</field>
        <field name="model_id" ref="model_salt_minion"/>
        <field name="binding_model_id" ref="model_salt_minion"/>
        <field name="state">code</field>
        <field name="code">records.action_fault_grow_log()</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="action_fault_wazuh_bruteforce" model="ir.actions.server">
        <field name="name">🚨 Simulera Wazuh-säkerhetshot (brute force)</field>
        <field name="model_id" ref="model_salt_minion"/>
        <field name="binding_model_id" ref="model_salt_minion"/>
        <field name="state">code</field>
        <field name="code">records.action_fault_wazuh_bruteforce()</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="action_fault_cleanup" model="ir.actions.server">
        <field name="name">🧹 Rensa felinjektioner</field>
        <field name="model_id" ref="model_salt_minion"/>
        <field name="binding_model_id" ref="model_salt_minion"/>
        <field name="state">code</field>
        <field name="code">records.action_fault_cleanup()</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
