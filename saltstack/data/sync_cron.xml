<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sync cron — created at install, interval controlled from Settings -->
    <record id="cron_sync_minions_pillars" model="ir.cron">
        <field name="name">Saltstack: synk minions &amp; pillars</field>
        <field name="model_id" ref="saltstack.model_salt_minion"/>
        <field name="state">code</field>
        <field name="code">model.action_cron_sync_all()</field>
        <field name="interval_number">24</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
