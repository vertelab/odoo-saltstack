# ── res.config.settings ────────────────────────────────────────────
msgid "Salt Master"
msgstr "Salt Master"

msgid "Address of the Salt master REST API (port 8377). e.g. http://192.168.11.22:8377"
msgstr "Adress till Salt-masterns REST API (port 8377). t.ex. http://192.168.11.22:8377"

msgid "Authentication token for the Salt REST API. The token can also be managed via Keykeep."
msgstr "Autentiseringstoken mot Salt REST API. Token kan även hanteras via Keykeep."

msgid "token = directly from the setting. keykeep = read from keykeep.credential (requires the saltstack_keykeep module)"
msgstr "token = direkt från inställningen. keykeep = läses från keykeep.credential (kräver saltstack_keykeep-modulen)"

msgid "Test the connection"
msgstr "Testa anslutningen"

msgid "Test Salt connection"
msgstr "Testa Salt-anslutning"

msgid "Pings the Salt master and shows the number of responding minions."
msgstr "Pingar Salt-mastern och visar antal svarande minions."

msgid "Automatic sync"
msgstr "Automatisk synk"

msgid "How often minions and pillars are synced automatically from the Salt Master."
msgstr "Hur ofta minions och pillars synkas automatiskt från Salt Master."

msgid "Sync every"
msgstr "Synka var"

msgid "hours"
msgstr "timmar"

msgid "Driftlarm (webhook)"
msgstr "Driftlarm (webhook)"

msgid "Shared webhook for Wazuh, Zabbix and Shuffle drift alerts."
msgstr "Gemensam webhook för Wazuh, Zabbix och Shuffle-driftlarm."

msgid "URL that Wazuh/Zabbix/Shuffle call to send drift alerts."
msgstr "URL som Wazuh/Zabbix/Shuffle anropar för att skicka driftlarm till."

msgid "Derive from web address"
msgstr "Härled från webbadress"

msgid "Fill in the URL from web.base.url (the server's public address)"
msgstr "Fyll i URL:en från web.base.url (serverns publika adress)"

msgid "API key"
msgstr "API-nyckel"

msgid "API key (Bearer token) sent in the Authorization header. Generated automatically at installation — press the button to create a new one."
msgstr "API-nyckel (Bearer token) som skickas med Authorization-headern. Genereras automatiskt vid installation — tryck på knappen för att skapa en ny."

msgid "Generate new key"
msgstr "Generera ny nyckel"

msgid "Create a new random API key (Bearer token)"
msgstr "Skapa en ny slumpmässig API-nyckel (Bearer token)"

msgid "Webhook enabled"
msgstr "Webhook aktiverad"

msgid "Correlation window (s)"
msgstr "Korrelationsfönster (s)"

msgid "Time window for Zabbix correlation (±)."
msgstr "Tidsfönster för Zabbix-korrelation (±)."

msgid "Auto diagnosis on alert"
msgstr "Auto-diagnos vid larm"

msgid "AI Coworker"
msgstr "AI Medarbetare"

msgid "AI coworker that performs diagnosis on drift alerts. Default is the Infrastructure Operator (bundled with the module)."
msgstr "AI Medarbetare som utför diagnos vid driftlarm. Default är Infrastructure Operator (följer med modulen)."

# ── settings fields (model) ────────────────────────────────────────
msgid "How to authenticate with the Salt API. \"Shared Secret\" uses the API key via /login. \"Keykeep Managed\" is available when the saltstack_keykeep module is installed."
msgstr "Hur autentisering mot Salt API ska ske. \"Shared Secret\" använder API-nyckeln via /login. \"Keykeep Managed\" är tillgänglig när saltstack_keykeep-modulen är installerad."

msgid "Shared Secret (API key)"
msgstr "Shared Secret (API-nyckel)"

msgid "Sync interval"
msgstr "Synk-intervall"

msgid "How often the minion and pillar sync runs (in hours)."
msgstr "Hur ofta minion- och pillar-synkningen körs (i timmar)."

msgid "URL that Wazuh/Zabbix call to send drift alerts (e.g. http://luke18:8069/saltstack/alert)."
msgstr "URL som Wazuh/Zabbix anropar för att skicka driftlarm (t.ex. http://luke18:8069/saltstack/alert)."

msgid "API key (Bearer token) that Wazuh/Zabbix send in the Authorization header to the webhook URL."
msgstr "API-nyckel (Bearer token) som Wazuh/Zabbix skickar i Authorization-headern till webhook-URL:en."

msgid "Enable/disable reception of drift alerts."
msgstr "Aktivera/avaktivera mottagning av driftlarm."

msgid "Time window in seconds for Zabbix correlation (±)."
msgstr "Tidsfönster i sekunder för Zabbix-korrelation (±)."

msgid "Start AI diagnosis automatically when an alert arrives."
msgstr "Starta AI-diagnos automatiskt vid larm."

# ── salt.minion ────────────────────────────────────────────────────
msgid "Logo"
msgstr "Logotyp"

msgid "Logo for the minion. Filled automatically based on role at sync, but can be updated manually in the form."
msgstr "Logotyp för minionen. Fylls automatiskt baserat på roll vid synk, men kan uppdateras manuellt i formuläret."

msgid "Cleanup all fault injections on this minion?"
msgstr "Rensa alla felinjektioner på denna minion?"

# ── menus / groups ─────────────────────────────────────────────────
msgid "Settings"
msgstr "Inställningar"

msgid "Saltstack Administrator"
msgstr "Saltstack-administratör"

msgid "Saltstack Administrator — also sees Configuration (Settings)."
msgstr "Saltstack-administratör — ser även Konfiguration (Inställningar)."

msgid "Inherits officer rights. Everyone in the Settings group (base.group_system)"
msgstr "Ärver officer-rättigheterna. Alla i Settings-gruppen (base.group_system)"
