<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Access groups ─────────────────────────────────────────────── -->
    <record id="group_saltstack_officer" model="res.groups">
        <field name="name">Saltstack-officer</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">
            Saltstack-officer — ser Saltstack-menyn med Pillars, Minions och
            Driftslarm, men INTE Konfiguration.
        </field>
    </record>

    <record id="group_saltstack_admin" model="res.groups">
        <field name="name">Saltstack Administrator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">
            Saltstack Administrator — also sees Configuration (Settings).
            Inherits officer rights. Everyone in the Settings group (base.group_system)
            blir automatiskt saltstack-admin.
        </field>
        <field name="implied_ids" eval="[(4, ref('group_saltstack_officer'))]"/>
    </record>

    <!-- Alla i Settings-gruppen (admin) blir automatiskt saltstack-admin -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_saltstack_admin'))]"/>
    </record>
</odoo>
