<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saltstack_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.saltstack</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Saltstack" string="Saltstack"
                     name="saltstack" data-icon="fa-server"
                     groups="base.group_system">

                    <block title="Salt Master">
                        <setting id="saltstack_api_url_setting"
                                 title="Salt API URL"
                                 help="Address of the Salt master REST API (port 8377). e.g. http://192.168.11.22:8377">
                            <field name="saltstack_api_url"
                                   placeholder="http://192.168.11.22:8377"
                                   class="w-50"/>
                        </setting>

                        <setting id="saltstack_api_token_setting"
                                 title="Salt API Token"
                                 help="Authentication token for the Salt REST API. The token can also be managed via Keykeep.">
                            <field name="saltstack_api_token"
                                   
                                   class="w-50"/>
                        </setting>

                        <setting id="saltstack_auth_method_setting"
                                 title="Salt Auth Method"
                                 help="token = directly from the setting. keykeep = read from keykeep.credential (requires the saltstack_keykeep module)">
                            <field name="saltstack_auth_method"/>
                        </setting>

                        <setting id="saltstack_test_setting"
                                 title="Test the connection">
                            <button name="action_test_salt" type="object"
                                    string="Test Salt connection"
                                    class="btn btn-primary" icon="fa-plug"/>
                            <div class="text-muted mt8">
                                Pings the Salt master and shows the number of responding minions.
                            </div>
                        </setting>

                        <setting id="saltstack_sync_setting"
                                 title="Automatic sync"
                                 help="How often minions and pillars are synced automatically from the Salt Master.">
                            <div class="d-flex align-items-center gap-2">
                                <span class="me-2">Sync every</span>
                                <field name="sync_interval_number" class="w-25"/>
                                <span>hours</span>
                            </div>
                        </setting>
                    </block>

                    <block title="Driftlarm (webhook)"
                           help="Shared webhook for Wazuh, Zabbix and Shuffle drift alerts.">
                        <setting id="alert_webhook_url_setting"
                                 title="Webhook URL"
                                 help="URL that Wazuh/Zabbix/Shuffle call to send drift alerts.">
                            <div class="d-flex align-items-center gap-2">
                                <field name="alert_webhook_url" class="flex-grow-1"
                                       placeholder="https://ledningssystem.vertel.se/saltstack/alert"/>
                                <button name="action_fill_webhook_url" type="object"
                                        string="Derive from web address"
                                        class="btn btn-secondary" icon="fa-globe"
                                        title="Fill in the URL from web.base.url (the server's public address)"/>
                            </div>
                        </setting>
                        <setting id="alert_webhook_token_setting"
                                 title="API key"
                                 help="API key (Bearer token) sent in the Authorization header. Generated automatically at installation — press the button to create a new one.">
                            <div class="d-flex align-items-center gap-2">
                                <field name="alert_webhook_token" class="flex-grow-1"/>
                                <button name="action_generate_webhook_token" type="object"
                                        string="Generate new key"
                                        class="btn btn-secondary" icon="fa-key"
                                        title="Create a new random API key (Bearer token)"/>
                            </div>
                        </setting>
                        <setting id="alert_webhook_enabled_setting"
                                 title="Webhook enabled">
                            <field name="alert_webhook_enabled"/>
                        </setting>
                        <setting id="alert_correlation_window_setting"
                                 title="Correlation window (s)"
                                 help="Time window for Zabbix correlation (±).">
                            <field name="alert_correlation_window" class="w-25"/>
                        </setting>
                        <setting id="alert_auto_diagnose_setting"
                                 title="Auto diagnosis on alert">
                            <field name="alert_auto_diagnose"/>
                        </setting>
                        <setting id="alert_coworker_setting"
                                 title="AI Coworker"
                                 help="AI coworker that performs diagnosis on drift alerts. Default is the Infrastructure Operator (bundled with the module).">
                            <field name="alert_coworker_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
