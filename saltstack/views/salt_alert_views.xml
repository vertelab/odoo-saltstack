<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── List View ─────────────────────────────────────────────── -->
    <!-- Ground-only: bridge modules (saltstack_zabbix, saltstack_ai)
         extend with their domain fields via xpath. -->
    <record id="view_salt_alert_list" model="ir.ui.view">
        <field name="name">saltstack.alert.list</field>
        <field name="model">saltstack.alert</field>
        <field name="arch" type="xml">
            <list decoration-danger="state in ('error', 'aborted')"
                  decoration-success="state in ('reported', 'deployed')"
                  decoration-muted="state == 'resolved'">
                <field name="name"/>
                <field name="state" widget="badge" decoration-danger="state in ('error','aborted')" decoration-success="state in ('reported','deployed')" decoration-muted="state=='resolved'"/>
                <field name="host"/>
                <field name="dc"/>
                <field name="source"/>
                <field name="category"/>
                <field name="severity"/>
                <field name="occurrences"/>
                <field name="last_occurrence"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────── -->
    <record id="view_salt_alert_form" model="ir.ui.view">
        <field name="name">saltstack.alert.form</field>
        <field name="model">saltstack.alert</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_resolved" type="object"
                            string="Mark as resolved" icon="fa-check"
                            confirm="Mark this alert as resolved?"
                            invisible="state in ('resolved', 'aborted')"/>
                    <button name="action_mark_deployed" type="object"
                            string="Deploy / Åtgärda" icon="fa-wrench"
                            invisible="state != 'reported'"/>
                    <button name="action_mark_error" type="object"
                            string="Flag error" icon="fa-exclamation-triangle"
                            invisible="state in ('resolved', 'aborted', 'error')"/>
                    <button name="action_mark_aborted" type="object"
                            string="Avbryt" icon="fa-ban"
                            invisible="state in ('resolved', 'aborted')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="reported,deployed,resolved,error,aborted"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="CRITICAL"
                            bg_color="text-bg-danger"
                            invisible="severity &lt; 12"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <notebook>
                        <page string="Översikt" name="overview">
                            <group>
                                <group string="Alert" class="alert-group">
                                    <field name="host"/>
                                    <field name="dc"/>
                                    <field name="source"/>
                                    <field name="category"/>
                                    <field name="severity"/>
                                    <field name="trigger_name"/>
                                </group>
                                <group string="Status" class="status-group">
                                    <field name="state"/>
                                    <field name="occurrences"/>
                                    <field name="last_occurrence"/>
                                    <field name="timestamp"/>
                                </group>
                            </group>
                        </page>
                        <page string="Detaljer" name="details">
                            <group string="Description" class="description-group">
                                <field name="description" nolabel="1" colspan="2"/>
                            </group>
                            <separator string="Raw log"/>
                            <field name="raw_log" nolabel="1" colspan="2"/>
                        </page>
                        <page string="Diagnos" name="diagnosis">
                            <group name="diagnosis_group">
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────────────── -->
    <record id="view_salt_alert_search" model="ir.ui.view">
        <field name="name">saltstack.alert.search</field>
        <field name="model">saltstack.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="host"/>
                <field name="trigger_name"/>
                <field name="category"/>
                <field name="source"/>
                <separator/>
                <filter name="critical" string="Critical (≥12)"
                        domain="[('severity', '>=', 12)]"/>
                <filter name="unresolved" string="Unresolved"
                        domain="[('resolved', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_host" string="Host"
                            context="{'group_by': 'host'}"/>
                    <filter name="group_source" string="Source"
                            context="{'group_by': 'source'}"/>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action + Menu ─────────────────────────────────────────── -->
    <record id="action_salt_alert" model="ir.actions.act_window">
        <field name="name">Drift Alerts</field>
        <field name="res_model">saltstack.alert</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_salt_alert_search"/>
    </record>
    <menuitem id="menu_salt_alert"
              name="Drift Alerts"
              parent="menu_saltstack_root"
              action="action_salt_alert"
              groups="saltstack.group_saltstack_officer"
              sequence="40"/>
</odoo>
