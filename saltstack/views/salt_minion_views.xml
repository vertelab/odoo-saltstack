<?xml version="1.0" encoding="utf-8"?>
    <odoo>
        <!-- ── Kanban View ───────────────────────────────────────────── -->
        <!--
             Kortet är byggt i tre lager (se openspec-ändringen
             omdesigna-minion-kanban) och ärvs av saltstack_storage, som
             hakar in lagringssumman i .o_minion_card__meta. Ändra därför
             inte klassnamnen utan att kontrollera den ärvda vyn:

               .o_minion_card__identity  — namn, kund (tier 1)
               .o_minion_card__attention — semafor, larmantal (tier 2)
               .o_minion_card__meta      — DC, logotyp, demo, lagring (tier 3)
        -->
        <record id="view_salt_minion_kanban" model="ir.ui.view">
            <field name="name">salt.minion.kanban</field>
            <field name="model">salt.minion</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile o_minion_card"
                        default_group_by="dc" quick_create="false">
                    <!-- Alla fält som används i <templates> måste deklareras
                         här. Fält som bara visas i formulär/listvy
                         (private_ip, public_ip, odoo_version, lxd_host,
                         storage_*) deklareras medvetet inte. -->
                    <field name="name"/>
                    <field name="customer"/>
                    <field name="partner_id"/>
                    <field name="dc"/>
                    <field name="state"/>
                    <field name="open_alert_count"/>
                    <field name="roles"/>
                    <field name="image"/>
                    <field name="is_demo"/>
                    <field name="is_container"/>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click position-relative o_minion_card__body o_minion_card__body--#{record.state.raw_value}">

                            <!-- Tier 3: DC-ribbon (platshållare man lär sig läsa) -->
                            <div t-if="record.dc.raw_value" class="ribbon ribbon-top-right">
                                <span t-att-class="record.dc.raw_value == 'ska' ? 'text-bg-primary' : 'text-bg-dark'">
                                    <field name="dc"/>
                                </span>
                            </div>

                            <!-- Vänster: bilden. Fast ruta, aldrig state-färgad —
                                 den bär teknik, inte tillstånd. -->
                            <aside class="o_minion_card__aside">
                                <t t-if="record.image.raw_value">
                                    <field name="image" widget="image"
                                           class="o_minion_card__logo"
                                           options="{'size': [64, 64]}"/>
                                </t>
                                <span t-else="" class="o_minion_card__logo o_minion_card__logo--fallback">
                                    <i class="fa fa-server"/>
                                </span>
                                <i t-if="record.is_container.raw_value"
                                   class="fa fa-cube o_minion_card__badge-corner"
                                   title="LXD-container" aria-label="LXD-container"/>
                            </aside>

                            <!-- Höger: innehållet -->
                            <div class="o_minion_card__details">

                                <!-- Tier 1: identitet -->
                                <div class="o_minion_card__identity">
                                    <strong class="o_kanban_record_title o_minion_card__title">
                                        <field name="name"/>
                                    </strong>
                                    <span t-if="record.is_demo.raw_value"
                                          class="badge text-bg-warning o_minion_card__demo">Demo</span>
                                    <div class="o_minion_card__customer">
                                        <t t-if="record.partner_id.raw_value">
                                            <i class="fa fa-user"/> <field name="partner_id"/>
                                        </t>
                                        <t t-elif="record.customer.raw_value">
                                            <i class="fa fa-user"/> <field name="customer"/>
                                        </t>
                                    </div>
                                </div>

                                <!-- Tier 2: åtgärdsbehov -->
                                <div class="o_minion_card__attention">
                                    <field name="state" widget="badge"
                                           class="o_minion_card__state"
                                           decoration-success="state == 'online'"
                                           decoration-danger="state == 'faulty'"
                                           decoration-muted="state == 'offline'"/>
                                    <button t-if="record.open_alert_count.raw_value &gt; 0"
                                            name="action_show_alerts" type="object"
                                            class="badge text-bg-danger o_minion_card__alerts border-0"
                                            title="Öppna driftlarm för denna minion"
                                            aria-label="Öppna driftlarm">
                                        <i class="fa fa-exclamation-triangle"/> <field name="open_alert_count"/>
                                    </button>
                                    <span t-if="record.roles.raw_value"
                                          class="o_minion_card__roles text-muted">
                                        <field name="roles"/>
                                    </span>
                                </div>

                                <!-- Tier 3: sekundär detalj. saltstack_storage
                                     hakar in lagringssumman här. -->
                                <div class="o_minion_card__meta"/>
                            </div>
                        </div>
                    </t>
                </kanban>
            </field>
        </record>
    
        <!-- ── List View ─────────────────────────────────────────────── -->
        <record id="view_salt_minion_list" model="ir.ui.view">
            <field name="name">salt.minion.list</field>
            <field name="model">salt.minion</field>
            <field name="arch" type="xml">
                <list decoration-danger="active == False"
                      decoration-warning="is_demo == True"
                      decoration-info="state == 'offline' and active == True">
                    <header>
                        <button name="saltstack.action_sync_minions_all" type="action"
                                display="always"
                                string="Synka minioner"
                                class="btn-primary" icon="fa-refresh"/>
                            <button name="saltstack.action_copy_hosts_list" type="action"
                                    display="always"
                                    string="Kopiera hosts-lista"
                                    icon="fa-copy"/>
                    </header>
                    <field name="name"/>
                    <field name="private_ip"/>
                    <button name="action_copy_private_ip" type="object"
                            icon="fa-copy" class="btn-link"
                            title="Kopiera IP till urklipp"/>
                    <field name="external_domain"/>
                    <button name="action_open_external_domain" type="object"
                            icon="fa-globe" class="btn-link"
                            title="Öppna extern domän i ny flik"/>
                    <field name="public_ip"/>
                    <field name="dc"/>
                    <field name="os"/>
                    <field name="roles"/>
                    <field name="customer"/>
                    <field name="snapshot_customer"/>
                    <field name="partner_id"/>
                    <field name="odoo_version"/>
                    <field name="odoo_has_demo_data" widget="boolean"/>
                    <field name="host_machine"/>
                    <field name="storage_total_gb" string="Storage (GB)"/>
                    <field name="odoo_user_count" string="Odoo-användare"/>
                    <field name="odoo_coworker_tokens_m" string="1M systemtokens"/>
                    <field name="state" decoration-danger="state == 'faulty'"
                           decoration-success="state == 'online'"
                           decoration-muted="state == 'offline'"/>
                    <field name="open_alert_count" string="Larm"
                           decoration-danger="open_alert_count &gt; 0"/>
                    <field name="is_container" widget="boolean"/>
                    <field name="is_demo" widget="boolean"/>
                    <field name="last_seen"/>
                    <field name="active" column_invisible="True"/>
                </list>
            </field>
        </record>
    
        <!-- ── Form View ─────────────────────────────────────────────── -->
        <record id="view_salt_minion_form" model="ir.ui.view">
            <field name="name">salt.minion.form</field>
            <field name="model">salt.minion</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_ping"
                                string="Ping"
                                type="object"
                                icon="fa-plug"/>
                        <button name="action_measure_storage"
                                string="Mät storage"
                                type="object"
                                icon="fa-database"
                                help="Measure/estimate the four storage rows (LXD host, Dirvish, S3, S3-backup)."/>
                        <button name="action_sync_borg_snapshots"
                                string="Synk Borg"
                                type="object"
                                icon="fa-archive"
                                groups="base.group_system"
                                help="Läs Borg-arkiven för denna maskin från backupservern (tull1) och uppdatera fliken Återskapa data. Körs normalt av cron 07:30."/>
                        <button name="action_fault_cleanup"
                                string="🧹 Rensa fel"
                                type="object"
                                icon="fa-broom"
                                confirm="Clear all fault injections on this minion?"/>
                        <field name="state" widget="state_status"/>
                    </header>
                    <sheet>
                        <div class="oe_title d-flex align-items-center gap-3">
                            <div>
                                <field name="image" widget="image" class="oe_avatar"
                                       style="float: none;"/>
                                <field name="image_manual" widget="boolean_toggle"
                                       class="small text-muted"
                                       title="När detta är på rör inte sync bilden. Sätts automatiskt när du laddar upp en egen logotyp."/>
                            </div>
                            <h1 class="mb-0"><field name="name" placeholder="Minion ID"/></h1>
                        </div>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_show_alerts" type="object"
                                    class="oe_stat_button" icon="fa-exclamation-triangle">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Driftslarm</span>
                                    <field name="open_alert_count" class="o_stat_value" widget="statinfo"/>
                                </div>
                            </button>
                            <button name="action_view_runlogs" type="object"
                                    class="oe_stat_button" icon="fa-book">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Run log</span>
                                    <field name="runlog_count" class="o_stat_value" widget="statinfo"/>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group string="Identity">
                                <field name="private_ip"/>
                                <field name="public_ip"/>
                                <field name="external_domain"/>
                                <field name="has_gateway"/>
                                <field name="os"/>
                                <field name="os_version"/>
                                <field name="dc"/>
                                <field name="roles"/>
                            </group>
                            <group string="Context">
                                <field name="customer"/>
                                <field name="partner_id"/>
                                <field name="odoo_version"/>
                                <field name="odoo_has_demo_data"/>
                                <field name="is_container"/>
                                <field name="host_machine"
                                       invisible="not is_container"/>
                                <field name="is_demo"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Storage">
                                <group>
                                    <group string="Summa">
                                        <field name="storage_primary_gb"/>
                                        <field name="storage_backup_gb"/>
                                        <field name="storage_total_gb"/>
                                    </group>
                                    <group string="Mätning">
                                        <field name="lxd_host" readonly="1"/>
                                    </group>
                                </group>
                                <div class="text-muted mb-2">
                                    Primärdata är kundens levande data
                                    (container, disk, Postgres, filestore).
                                    Backup är en <em>kopia</em> av samma data
                                    och räknas aldrig in i primärsumman.
                                </div>
                                <field name="storage_ids" nolabel="1">
                                    <list editable="bottom"
                                          decoration-muted="legacy_reference"
                                          decoration-info="is_measured == False">
                                        <field name="storage_type"/>
                                        <field name="layer" optional="show"/>
                                        <field name="provider"/>
                                        <field name="bytes_used" optional="hide"/>
                                        <field name="size_gb" sum="Summa använt"/>
                                        <field name="bytes_allocated"
                                               optional="hide"/>
                                        <field name="allocated_gb"
                                               optional="show"/>
                                        <field name="is_measured"/>
                                        <field name="method"/>
                                        <field name="measured_at"/>
                                        <field name="legacy_reference"
                                               optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Återskapa data"
                                  invisible="not snapshot_ids and not dirvish_snapshot_ids and not borg_snapshot_ids">
                                <!-- Tydlig informationsruta: VAR körs kommandot? -->
                                <div class="alert alert-info" role="alert">
                                    <h4 class="alert-title">
                                        <i class="fa fa-server me-1"/>
                                        Restore-kommandon körs på
                                        <field name="restore_target_info" class="d-inline fw-bold"/>
                                    </h4>
                                    <p class="mb-1">
                                        Logga in på maskinen ovan (t.ex. <code>ssh ubuntu@&lt;adress&gt;</code>) och
                                        klistra in kommandot — eller använd <b>SSH-kommandot</b>
                                        (kopiera-knappen längst till höger), som redan innehåller
                                        både maskin och <code>sudo</code> och kan klistras in varifrån som helst.
                                    </p>
                                    <p class="mb-0">
                                        <i class="fa fa-info-circle me-1"/>
                                        <b>Restic</b>-rader: kommandot måste köras därför att kundens
                                        credentials (<code>/etc/rclone/&lt;kund&gt;.conf</code> och
                                        <code>/etc/garage-backup/restic-password</code>) bara finns på
                                        den maskinen. Data hamnar under <code>/restore/&lt;kund&gt;</code>.
                                        <br/>
                                        <b>Dirvish</b>-rader: listan visar bara datum som har data
                                        (branches med <code>tree/</code>). Datumkataloger utan data
                                        (misslyckade backuper) visas inte — det finns inget att
                                        återskapa där. Data hamnar under
                                        <code>/restore/&lt;vault&gt;-&lt;datum&gt;</code>.
                                        <br/>
                                        <b>Borg</b>-rader: varje rad är ett arkiv i Borg-repot på
                                        backupservern. Kommandot <code>borg extract</code> återställer
                                        till aktuell katalog — ange <code>--target</code> för att välja
                                        plats. Repona ligger på <code>tull1</code> under
                                        <code>/srv/borgbackup/lxd/&lt;värd&gt;</code>.
                                    </p>
                                </div>
                                <!-- ── Restic-snapshots ─────────────────────────── -->
                                <group invisible="not snapshot_ids">
                                    <h4>
                                        <i class="fa fa-database me-1"/>
                                        Restic (Garage S3)
                                    </h4>
                                    <field name="snapshot_ids" nolabel="1" colspan="2">
                                        <list>
                                            <field name="time"/>
                                            <field name="short_id"/>
                                            <field name="server_label" string="Körs på"/>
                                            <field name="tags"/>
                                            <field name="size"/>
                                            <field name="file_count"/>
                                            <button name="action_copy_restore_cmd"
                                                    type="object"
                                                    icon="fa-terminal"
                                                    class="btn-link"
                                                    title="Kopiera kommandot (att köra PÅ backup-servern)"/>
                                            <button name="action_copy_restore_cmd_ssh"
                                                    type="object"
                                                    icon="fa-copy"
                                                    class="btn-link"
                                                    title="Kopiera SSH-kommandot (innehåller maskinen — kan köras varifrån som helst)"/>
                                        </list>
                                    </field>
                                </group>
                                <!-- ── Dirvish-snapshots ────────────────────────── -->
                                <group invisible="not dirvish_snapshot_ids">
                                    <h4>
                                        <i class="fa fa-hdd-o me-1"/>
                                        Dirvish
                                    </h4>
                                    <field name="dirvish_snapshot_ids" nolabel="1" colspan="2">
                                        <list>
                                            <field name="time"/>
                                            <field name="vault"/>
                                            <field name="server_label" string="Körs på"/>
                                            <field name="path"/>
                                            <button name="action_copy_restore_cmd"
                                                    type="object"
                                                    icon="fa-terminal"
                                                    class="btn-link"
                                                    title="Kopiera kommandot (att köra PÅ dirvish-servern)"/>
                                            <button name="action_copy_restore_cmd_ssh"
                                                    type="object"
                                                    icon="fa-copy"
                                                    class="btn-link"
                                                    title="Kopiera SSH-kommandot (innehåller maskinen — kan köras varifrån som helst)"/>
                                        </list>
                                    </field>
                                </group>
                                <!-- ── Borg-snapshots ──────────────────────────── -->
                                <group invisible="not borg_snapshot_ids">
                                    <h4>
                                        <i class="fa fa-archive me-1"/>
                                        Borg (LXD-containrar)
                                    </h4>
                                    <field name="borg_snapshot_ids" nolabel="1" colspan="2">
                                        <list>
                                            <field name="time"/>
                                            <field name="short_id"/>
                                            <field name="server_label" string="Körs på"/>
                                            <field name="path"/>
                                            <button name="action_copy_restore_cmd"
                                                    type="object"
                                                    icon="fa-terminal"
                                                    class="btn-link"
                                                    title="Kopiera kommandot (att köra PÅ backupservern)"/>
                                            <button name="action_copy_restore_cmd_ssh"
                                                    type="object"
                                                    icon="fa-copy"
                                                    class="btn-link"
                                                    title="Kopiera SSH-kommandot (innehåller maskinen — kan köras varifrån som helst)"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Odoo"
                                  invisible="not odoo_version and not odoo_databases">
                                <group>
                                    <group>
                                        <field name="odoo_version"/>
                                        <field name="odoo_databases"/>
                                        <field name="odoo_has_demo_data"/>
                                        <field name="odoo_stats_synced"/>
                                    </group>
                                    <group>
                                        <field name="odoo_user_count"/>
                                        <field name="odoo_last_login"/>
                                        <field name="odoo_coworker_count"/>
                                        <field name="odoo_coworker_tokens_m"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Status">
                                <group>
                                    <field name="state"/>
                                    <field name="open_alert_count"/>
                                    <field name="last_seen"/>
                                    <field name="last_sync"/>
                                </group>
                            </page>
                            <page string="Run log">
                                <!-- Förklarande ruta: hur funktionen används -->
                                <div class="alert alert-info" role="status">
                                    <h4 class="alert-title">
                                        <i class="fa fa-book me-1" title="Driftslogg"/>
                                        Run log — what has been done on this machine?
                                    </h4>
                                    <p class="mb-1">
                                        This collects both <b>automatic runs</b>
                                        (backup, highstate, sync) and
                                        <b>manual changes</b>. Write a note when you
                                        change something — then the trail remains.
                                    </p>
                                    <p class="mb-1">
                                        <i class="fa fa-magic me-1" title="Automatic"/>
                                        <b>Automatic entries</b> are created by the sender via
                                        the webhook <code>/saltstack/log</code> (restic, dirvish,
                                        odoosa, github-backup) and linked here via
                                        the <code>host</code> field.
                                    </p>
                                    <p class="mb-0">
                                        <i class="fa fa-pencil me-1" title="Manual"/>
                                        <b>Manual entries</b> are added with the
                                        <b>New note</b> button above — or by Pi after a
                                        completed change. They are marked with the source
                                        <i>Manual action</i> and the type <i>Change</i>.
                                    </p>
                                </div>
                                <div class="d-flex justify-content-end mb-2">
                                    <button name="action_add_runlog"
                                            string="New note"
                                            type="object"
                                            class="btn-primary"
                                            icon="fa-plus"/>
                                </div>
                                <field name="runlog_ids" nolabel="1" colspan="2">
                                    <list default_order="timestamp desc"
                                          decoration-danger="status == 'error'"
                                          decoration-warning="status == 'warning'"
                                          decoration-success="status == 'ok'">
                                        <field name="timestamp"/>
                                        <field name="source"/>
                                        <field name="run_type"/>
                                        <field name="status"/>
                                        <field name="summary"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <group>
                                    <field name="notes" nolabel="1" colspan="2"/>
                                </group>
                            </page>
                            <page string="Grains">
                                <group>
                                    <field name="grains_json" nolabel="1" colspan="2"/>
                                </group>
                            </page>
                        </notebook>
                        <widget name="web_ribbon" title="Inaktiv"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
    
        <!-- ── Search View ───────────────────────────────────────────── -->
        <record id="view_salt_minion_search" model="ir.ui.view">
            <field name="name">salt.minion.search</field>
            <field name="model">salt.minion</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="private_ip"/>
                    <field name="public_ip"/>
                    <field name="customer"/>
                    <field name="partner_id"/>
                    <field name="dc"/>
                    <field name="roles"/>
                    <field name="host_machine"/>
                    <separator/>
                    <filter name="inactive" string="Inaktiverade"
                            domain="[('active', '=', False)]"/>
                    <filter name="active_only" string="Aktiva"
                            domain="[('active', '=', True)]"/>
                    <separator/>
                    <filter name="online" string="Online"
                            domain="[('state', '=', 'online')]"/>
                    <filter name="offline" string="Offline"
                            domain="[('state', '=', 'offline')]"/>
                    <filter name="faulty" string="Har larm (faulty)"
                            domain="[('state', '=', 'faulty')]"/>
                    <filter name="has_alerts" string="Har larm"
                            domain="[('open_alert_count', '&gt;', 0)]"/>
                    <filter name="containers" string="Containers"
                            domain="[('is_container', '=', True)]"/>
                    <separator/>
                    <filter name="demo" string="Demo/Test"
                            domain="[('is_demo', '=', True)]"/>
                    <filter name="production" string="Production"
                            domain="[('is_demo', '=', False)]"/>
                    <filter name="demo_data" string="Odoo demodata"
                            domain="[('odoo_has_demo_data', '=', True)]"/>
                    <separator/>
                    <filter name="has_storage" string="Har lagringsmätning"
                            domain="[('storage_ids', '!=', False)]"/>
                    <filter name="has_legacy_storage"
                            string="Har historiska lagringsrader"
                            domain="[('storage_ids.legacy_reference', '=', True)]"/>
                    <separator/>
                    <filter name="ska" string="SKA" domain="[('dc', '=', 'ska')]"/>
                    <filter name="sto" string="STO" domain="[('dc', '=', 'sto')]"/>
                    <filter name="lab" string="Lab" domain="[('dc', '=', 'lab')]"/>
                    <filter name="dc_unknown" string="Unknown DC"
                            domain="[('dc', '=', False)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_dc" string="Datacenter"
                                context="{'group_by':'dc'}"/>
                        <filter name="group_by_state" string="Status"
                                context="{'group_by':'state'}"/>
                        <filter name="group_by_os" string="OS"
                                context="{'group_by':'os'}"/>
                        <filter name="group_by_host" string="LXD Host"
                                context="{'group_by':'host_machine'}"/>
                        <filter name="group_by_customer" string="Customer"
                                context="{'group_by':'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    
        <!-- ── Action ───────────────────────────────────────────────── -->
        <record id="action_salt_minion" model="ir.actions.act_window">
            <field name="name">Minions</field>
            <field name="res_model">salt.minion</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_salt_minion_search"/>
        </record>
    
        <!-- ── Menu ──────────────────────────────────────────────────── -->
        <menuitem id="menu_salt_minion"
                  name="Minions"
                  parent="menu_saltstack_root"
                  action="action_salt_minion"
                  groups="saltstack.group_saltstack_officer"
                  sequence="10"/>
    
    </odoo>
