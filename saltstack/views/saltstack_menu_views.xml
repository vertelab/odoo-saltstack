<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Root menu ─────────────────────────────────────────────────── -->
    <menuitem id="menu_saltstack_root"
              name="Saltstack"
              sequence="90"
              web_icon="saltstack,static/description/icon.png"
              groups="saltstack.group_saltstack_officer"/>

    <!-- ── Konfiguration (parent, endast admin) ────────────────────── -->
    <menuitem id="menu_saltstack_config"
              name="Konfiguration"
              parent="menu_saltstack_root"
              sequence="100"
              groups="saltstack.group_saltstack_admin"/>

    <!-- ── Settings (first in Configuration) ─────────────────────── -->
    <record id="action_saltstack_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{}</field>
    </record>
    <menuitem id="menu_saltstack_settings"
              name="Settings"
              parent="menu_saltstack_config"
              action="action_saltstack_settings"
              sequence="10"/>

    <!-- ── Sync actions (server actions from data/sync_actions.xml) ── -->
    <menuitem id="menu_sync_minions"
              name="Synka minions"
              parent="menu_saltstack_config"
              action="action_sync_minions_all"
              sequence="20"
              groups="saltstack.group_saltstack_admin"/>

    <menuitem id="menu_sync_pillars"
              name="Synka pillars"
              parent="menu_saltstack_config"
              action="action_sync_pillars_all"
              sequence="30"
              groups="saltstack.group_saltstack_admin"/>

    <!-- ── Schemalagda jobb (cron_tick) ──────────────────────────────── -->
    <!--
         Menyn pekar på `cron_tick`s EGEN action, filtrerad på modulens jobb
         — samma mönster som `saltstack_storage/views/storage_menu_views.xml`
         redan använder. Vi bygger ingen egen tabell: `cron.task`-listvyn har
         körhistorik, felmeddelande, lås, hälsoläge och överskriden deadline,
         och en "Kör nu" som går genom samma låsta körväg som schemat.

         `domain` ligger i actionens `context` (inte i menyn) eftersom
         `ir.actions.act_window` är det som öppnas — menyn är bara en ingång.
    -->
    <record id="action_saltstack_cron_tasks" model="ir.actions.act_window">
        <field name="name">Schemalagda jobb</field>
        <field name="res_model">cron.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="cron_tick.view_cron_task_search"/>
        <field name="domain">[('module', '=', 'saltstack')]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Inga schemalagda jobb
            </p>
            <p>
                Jobben deklareras som data-XML i modulen och körs av
                cron_tick-motorn. Intervallet ändras här — inte i
                Inställningar.
            </p>
        </field>
    </record>

    <menuitem id="menu_saltstack_cron_tasks"
              name="Schemalagda jobb"
              parent="menu_saltstack_config"
              action="action_saltstack_cron_tasks"
              sequence="40"
              groups="saltstack.group_saltstack_admin"/>
</odoo>
