<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shuffle_app_list" model="ir.ui.view">
        <field name="name">shuffle.app.list</field>
        <field name="model">shuffle.app</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="app_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_shuffle_app_form" model="ir.ui.view">
        <field name="name">shuffle.app.form</field>
        <field name="model">shuffle.app</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="app_id"/>
                            <field name="api_key" password="True"/>
                            <field name="active"/>
                        </group>
                        <group string="Konfig (JSON)">
                            <field name="config_json" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shuffle_app" model="ir.actions.act_window">
        <field name="name">Appar</field>
        <field name="res_model">shuffle.app</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
