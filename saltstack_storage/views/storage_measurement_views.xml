<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Measurements: list / form / pivot / search ────────────────── -->

    <record id="view_storage_measurement_list" model="ir.ui.view">
        <field name="name">saltstack.storage.measurement.list</field>
        <field name="model">saltstack.storage.measurement</field>
        <field name="arch" type="xml">
            <list decoration-muted="is_stale" decoration-info="method == 'estimated'">
                <field name="measured_at"/>
                <field name="minion_id"/>
                <field name="partner_id" optional="show"/>
                <field name="artifact"/>
                <field name="subject"/>
                <field name="used_gb" sum="Summa använt"/>
                <field name="allocated_gb" optional="hide"/>
                <field name="secondary_gb" optional="hide"/>
                <field name="deviation_gb"
                       decoration-warning="deviation_gb != 0"
                       optional="show"/>
                <field name="layer" optional="show"/>
                <field name="method"/>
                <field name="source" optional="hide"/>
                <field name="is_stale" optional="show"/>
                <field name="legacy_reference" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_storage_measurement_form" model="ir.ui.view">
        <field name="name">saltstack.storage.measurement.form</field>
        <field name="model">saltstack.storage.measurement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="is_stale" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_stale">
                        Mätningen är äldre än förväntat intervall. Siffran är
                        senast kända värde, inte aktuell.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="method != 'estimated'">
                        Värdet är <strong>beräknat</strong>, inte uppmätt på
                        disk. Presentera det aldrig som en exakt mätning.
                    </div>
                </header>
                <sheet>
                    <group>
                        <group string="Mätobjekt">
                            <field name="minion_id"/>
                            <field name="partner_id"/>
                            <field name="artifact"/>
                            <field name="subject"/>
                            <field name="layer"/>
                        </group>
                        <group string="Värden">
                            <field name="used_gb"/>
                            <field name="allocated_gb"/>
                            <field name="secondary_gb"/>
                            <field name="deviation_gb"/>
                        </group>
                    </group>
                    <group>
                        <group string="Härkomst">
                            <field name="measured_at"/>
                            <field name="method"/>
                            <field name="source"/>
                            <field name="legacy_reference"/>
                            <field name="note"/>
                        </group>
                        <group string="Rådata">
                            <field name="raw" widget="json"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_storage_measurement_pivot" model="ir.ui.view">
        <field name="name">saltstack.storage.measurement.pivot</field>
        <field name="model">saltstack.storage.measurement</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="partner_id" type="row"/>
                <field name="artifact" type="col"/>
                <field name="used_gb" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_storage_measurement_search" model="ir.ui.view">
        <field name="name">saltstack.storage.measurement.search</field>
        <field name="model">saltstack.storage.measurement</field>
        <field name="arch" type="xml">
            <search>
                <field name="minion_id"/>
                <field name="partner_id"/>
                <field name="subject"/>
                <filter name="filter_stale" string="Inaktuella"
                        domain="[('is_stale', '=', True)]"/>
                <filter name="filter_estimated" string="Beräknade"
                        domain="[('method', '=', 'estimated')]"/>
                <filter name="filter_primary" string="Primärdata"
                        domain="[('layer', '=', 'primary')]"/>
                <filter name="filter_backup" string="Backup"
                        domain="[('layer', '=', 'backup')]"/>
                <separator/>
                <filter name="filter_no_partner" string="Ej kundkopplade"
                        domain="[('partner_id', '=', False)]"/>
                <filter name="filter_legacy" string="Historisk referens"
                        domain="[('legacy_reference', '=', True)]"/>
                <group expand="0" string="Gruppera efter">
                    <filter name="group_partner" string="Kund"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_artifact" string="Artefakt"
                            context="{'group_by': 'artifact'}"/>
                    <filter name="group_layer" string="Lager"
                            context="{'group_by': 'layer'}"/>
                    <filter name="group_measured" string="Mätt"
                            context="{'group_by': 'measured_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Customer/project summary ──────────────────────────────────── -->
    <!-- The two-layer sum is computed per customer in the pivot and in the
         minion smart button. This action is the "who uses what" entry. -->
    <record id="action_storage_measurement_customer" model="ir.actions.act_window">
        <field name="name">Lagring per kund</field>
        <field name="res_model">saltstack.storage.measurement</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="domain">[('legacy_reference', '=', False)]</field>
        <field name="context">{'search_default_group_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ingen lagringsmätning ännu
            </p>
            <p>
                Kör <em>Storage: samla in lagringsmätningar</em> i
                cron_tick-registret, eller
                <code>POST /cron/trigger/storage_collect</code>.
            </p>
        </field>
    </record>

    <record id="action_storage_measurement_all" model="ir.actions.act_window">
        <field name="name">Lagringsmätningar</field>
        <field name="res_model">saltstack.storage.measurement</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="context">{'search_default_group_artifact': 1}</field>
    </record>
</odoo>
