<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SCENARIO 1: Disk Full                                            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="demo_scenario_disk_full" model="saltstack.demo.scenario">
        <field name="name">Disk Full — Odoo Log Explosion</field>
        <field name="scenario_type">disk_full</field>
        <field name="description">
1. Fyll /tmp på test-odoo-1 med 500MB tempfil
2. Zabbix trigger: "No free space"
3. Coworker detekterar via zabbix_get_alerts
4. Coworker analyserar via salt_disk_usage
5. Coworker rensar via salt_cmd_run (rm tempfiler)
6. Coworker kvitterar i Zabbix
        </field>
        <field name="target_minion">test-odoo-1</field>
        <field name="fault_type">disk_fill</field>
        <field name="fault_params">{"size_mb": 500, "path": "/tmp"}</field>
        <field name="expected_actions">[
            "zabbix_get_alerts",
            "salt_disk_usage",
            "salt_journal_errors",
            "salt_cmd_run",
            "zabbix_acknowledge"
        ]</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SCENARIO 2: Service Crash                                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="demo_scenario_odoo_down" model="saltstack.demo.scenario">
        <field name="name">Odoo Service Crash</field>
        <field name="scenario_type">service_down</field>
        <field name="description">
1. Döda odoo-processen på test-odoo-1
2. Zabbix trigger: "Odoo HTTP endpoint not responding"
3. Coworker pingar, kollar status, läser loggar
4. Coworker startar om tjänsten
5. Coworker verifierar
6. Coworker kvitterar + skapar helpdesk-ärende
        </field>
        <field name="target_minion">test-odoo-1</field>
        <field name="fault_type">kill_process</field>
        <field name="fault_params">{"process": "odoo"}</field>
        <field name="expected_actions">[
            "zabbix_get_alerts",
            "salt_service_status",
            "salt_journal_errors",
            "salt_service_restart",
            "zabbix_acknowledge",
            "create_helpdesk_ticket"
        ]</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SCENARIO 3: Pentest Finding                                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="demo_scenario_strix_finding" model="saltstack.demo.scenario">
        <field name="name">Strix Pentest — Critical Finding on Gateway</field>
        <field name="scenario_type">pentest_finding</field>
        <field name="description">
1. Simulera Strix critical finding på test-gw0
2. Finding skickas till Zabbix
3. Zabbix webhook → coworker
4. Coworker analyserar finding
5. Coworker kollar Wazuh-larm för samma host
6. Coworker skapar helpdesk-ärende med hög prio
7. Coworker notifierar
        </field>
        <field name="target_minion">test-gw0</field>
        <field name="fault_type">none</field>
        <field name="expected_actions">[
            "zabbix_get_alerts",
            "zabbix_get_host",
            "zabbix_get_triggers",
            "create_helpdesk_ticket"
        ]</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SCENARIO 4: SIEM Brute Force                                     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="demo_scenario_siem_bruteforce" model="saltstack.demo.scenario">
        <field name="name">Wazuh SIEM — SSH Brute Force Detection</field>
        <field name="scenario_type">siem_alert</field>
        <field name="description">
1. Simulera SSH brute force på test-gw0
2. Wazuh-agent detekterar → Wazuh Manager → Zabbix
3. Zabbix webhook → coworker
4. Coworker kollar auth.log via salt
5. Coworker kollar Wazuh alert-detaljer
6. Coworker blockerar IP (eller eskalerar)
7. Coworker kvitterar + dokumenterar
        </field>
        <field name="target_minion">test-gw0</field>
        <field name="fault_type">none</field>
        <field name="expected_actions">[
            "zabbix_get_alerts",
            "salt_journal_errors",
            "salt_cmd_run",
            "zabbix_acknowledge",
            "document_anomaly"
        ]</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SCENARIO 5: Customer Deploy                                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="demo_scenario_customer_deploy" model="saltstack.demo.scenario">
        <field name="name">Customer Deployment — New Odoo Instance</field>
        <field name="scenario_type">customer_deploy</field>
        <field name="description">
1. Användare: "@infra driftsätt testkund2.se"
2. Coworker frågar om Odoo-version, moduler, datacenter
3. Coworker kör container_create (mock)
4. Coworker kör repo_apply (mock)
5. Coworker kör caddy_site (mock)
6. Coworker verifierar och rapporterar
        </field>
        <field name="target_minion">test-fors</field>
        <field name="fault_type">none</field>
        <field name="expected_actions">[
            "salt_cmd_run",
            "salt_service_status",
            "salt_test_ping"
        ]</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SCENARIO 6: HA Failover                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="demo_scenario_ha_failover" model="saltstack.demo.scenario">
        <field name="name">HA Failover — Primary Switch</field>
        <field name="scenario_type">ha_failover</field>
        <field name="description">
1. Simulera planerad HA-failover
2. Coworker kör caddy_site_ha --primary sto
3. Verifiera PostgreSQL replication status
4. Verifiera Odoo HTTP 200 på ny primary
5. Dokumentera händelsen
        </field>
        <field name="target_minion">test-gw0</field>
        <field name="fault_type">none</field>
        <field name="expected_actions">[
            "salt_cmd_run",
            "salt_service_status",
            "zabbix_get_triggers",
            "document_anomaly"
        ]</field>
    </record>

</odoo>
