<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ACCESS-GRUPPER (ai-tool-access-capabilities)                     -->
    <!-- Operatorrollen styr vem som får använda salt/zabbix-verktygen.   -->
    <!-- Alla verktyg binds till gruppen — även läsverktyg (pillar/grains -->
    <!-- innehåller hemligheter). Destruktiva verktyg kräver dessutom     -->
    <!-- alltid HITL via risk_level.                                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <record id="group_infra_operator" model="res.groups">
        <field name="name">Infrastructure Operator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Roll för att använda Infrastructure Operator-coworkern och dess salt/zabbix-verktyg via AI.</field>
    </record>

    <!-- SaltStack-verktyg → operatorgruppen -->
    <record id="tool_salt_test_ping" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_state_apply" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
