<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ACCESS GROUPS (ai-tool-access-capabilities)                     -->
    <!-- The operator role controls who may use the salt/zabbix tools.   -->
    <!-- All tools are bound to the group — including read tools        -->
    <!-- (pillar/grains contain secrets). Destructive tools also require -->
    <!-- HITL via risk_level at all times.                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <record id="group_infra_operator" model="res.groups">
        <field name="name">Infrastructure Operator</field>
        <field name="category_id" ref="saltstack.module_category_saltstack"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Role for using the Infrastructure Operator coworker and its salt/zabbix tools via AI.</field>
    </record>

    <!-- SaltStack-verktyg → operatorgruppen -->
    <record id="tool_salt_test_ping" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_state_apply" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_state_highstate" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_state_show_sls" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_cmd_run" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_pillar_get" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_pillar_items" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_grains_get" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_grains_items" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_minion_list" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_minion_accept" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_service_status" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_service_restart" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_disk_usage" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_memory_usage" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_system_load" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_journal_errors" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_salt_process_list" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>

    <!-- Zabbix-verktyg → operatorgruppen -->
    <record id="tool_zabbix_get_alerts" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_zabbix_get_host" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_zabbix_get_problems" model="ai.tool">
