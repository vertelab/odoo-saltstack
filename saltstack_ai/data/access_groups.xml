    </record>
    <record id="tool_zabbix_get_history" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_zabbix_get_item" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_zabbix_get_host_groups" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
    <record id="tool_zabbix_get_triggers" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>

    <!-- Driftlarm-verktyget → operatorgruppen -->
    <record id="tool_driftlarm_update" model="ai.tool">
        <field name="group_ids" eval="[(4, ref('group_infra_operator'))]"/>
    </record>
</odoo>
