#. module: saltstack_wazuh
msgid "Salt minion-ID for the Wazuh Manager server. Used by SIEM tools to run agent_control etc."
msgstr "Salt minion-ID för Wazuh Manager-servern. Används av SIEM-verktygen för att köra agent_control etc."

#. module: saltstack_wazuh
msgid "token = directly from the setting. keykeep = read from keykeep.credential (purpose=siem_api)"
msgstr "token = direkt från inställningen. keykeep = läses från keykeep.credential (purpose=siem_api)"

#. module: saltstack_wazuh
msgid "Wazuh source for Drift Alerts — selection_add + settings"
msgstr "Wazuh-källa för Driftslarm — selection_add + settings"
